# Database
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/formflow?schema=public"

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Email delivery
# NOT CONFIGURED FOR PRODUCTION. No provider is wired up yet.
#   development: messages print to the server console and are viewable at the
#     dev-only GET /api/dev/mail route (404s in production)
#   production:  if EMAIL_PROVIDER is unset, messages are dropped with a
#     warning and password reset / email verification do not work
# To add a provider, set its credentials below and add a branch to
# src/lib/email/index.ts. Never commit real credentials.
# EMAIL_PROVIDER="smtp"
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="your-smtp-user"
# EMAIL_SERVER_PASSWORD="your-smtp-password"
# EMAIL_FROM="noreply@formflow.dev"

# Email verification / password reset tokens
# Lifetimes in milliseconds. Verification is forgiving (a day to open an email);
# reset is tight because it grants account takeover.
EMAIL_VERIFICATION_TOKEN_TTL_MS="86400000"
PASSWORD_RESET_TOKEN_TTL_MS="3600000"

# Anti-enumeration: pads the forgot-password and resend-verification responses
# out to a fixed floor so response time doesn't reveal whether an account exists.
AUTH_MIN_RESPONSE_MS="400"

# Rate limits for the auth endpoints. Per-email is tight (stops an attacker
# spamming one victim's inbox); per-IP is loose so users behind a shared
# corporate NAT don't notice it.
AUTH_RATE_LIMIT_MAX="3"
AUTH_IP_RATE_LIMIT_MAX="20"
AUTH_RATE_LIMIT_WINDOW_MS="900000"

# Stripe (Phase 2+)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FormFlow"